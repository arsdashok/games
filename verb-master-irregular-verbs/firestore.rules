rules_version = '2';

// Verb Master cloud sync (simple name+password accounts, anonymous device auth).
// Requires Anonymous Authentication to be enabled in Firebase Console
// (Authentication → Sign-in method → Anonymous → Enable).
// Every device signs in anonymously; only authenticated clients may touch data.
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per account: vm_users/{role_name} — profile, progress, passHash
    match /vm_users/{uid} {
      allow read, write: if request.auth != null;
    }

    // One doc per teacher class code: vm_classes/{CODE}
    match /vm_classes/{code} {
      allow read, write: if request.auth != null;
    }

    // Everything else: locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
